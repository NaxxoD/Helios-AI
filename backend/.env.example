# ── Base de données ──────────────────────────────────────────────
# psycopg v3 — NE PAS utiliser postgresql:// (psycopg2 interdit sur Windows FR)
DATABASE_URL=postgresql+psycopg://helios:helios@localhost:5433/helios

# ── Sécurité ─────────────────────────────────────────────────────
SECRET_KEY=change-this-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# ── Frontend ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── MinIO (stockage fichiers) ────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_USER=helios
MINIO_PASSWORD=helios123
MINIO_BUCKET=conversations

# ── Email (laisser vide pour désactiver les envois) ──────────────
MAIL_USERNAME=
MAIL_PASSWORD=
